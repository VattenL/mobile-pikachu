@startuml uc-m4-play-online-match
title Biểu đồ use case chi tiết - Modul Play Online Match

left to right direction
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 90
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
}
skinparam actor {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}

actor "Player" as Player

rectangle "Modul: Play Online Match" {
  usecase "Play Online Match" as UC08
  usecase "Login" as UC02
  usecase "Challenge Player" as UC06
  usecase "Respond To Challenge" as UC07
  usecase "Match Tiles" as UC08_1
  usecase "Decide To Continue" as UC08_2
  usecase "Quit Match" as UC08_3
}

Player --> UC08

UC08 ..> UC02 : <<include>>
UC08 ..> UC06 : <<include>>
UC08 ..> UC07 : <<include>>
UC08 ..> UC08_1 : <<include>>
UC08 ..> UC08_2 : <<include>>
UC08 <.. UC08_3 : <<extend>>
@enduml
