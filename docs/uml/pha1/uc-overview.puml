@startuml uc-overview
title Biểu đồ use case tổng quan - Game Pikachu

left to right direction
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 80
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
}
skinparam actor {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}

actor "Guest" as Guest
actor "Player" as Player

rectangle "Game Pikachu" {
  usecase "Register Account" as UC01
  usecase "Login" as UC02
  usecase "View Ranking" as UC04
  usecase "Play With Bot" as UC05
  usecase "Logout" as UC03
  usecase "Challenge Player" as UC06
  usecase "Respond To Challenge" as UC07
  usecase "Play Online Match" as UC08
}

Player -|> Guest
Guest --> UC01
Guest --> UC02
Guest --> UC04
Guest --> UC05
Player --> UC03
Player --> UC06
Player --> UC07
Player --> UC08
@enduml
