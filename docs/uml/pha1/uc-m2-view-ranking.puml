@startuml uc-m2-view-ranking
title Biểu đồ use case chi tiết - Modul View Ranking

left to right direction
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 90
skinparam usecase {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
}
skinparam actor {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}

actor "Guest" as Guest
actor "Player" as Player

rectangle "Modul: View Ranking" {
  usecase "View Ranking" as UC04
  usecase "Locate My Rank" as UC04_1
  usecase "Login" as UC02
}

Player -|> Guest
Guest --> UC04
UC04 <.. UC04_1 : <<extend>>
UC04_1 ..> UC02 : <<include>>
@enduml
