@startuml
title Biểu đồ lớp thiết kế - Modul Play With Bot

' ========================================================
' TẦNG 1: GIAO DIỆN CLIENT
' ========================================================
class MainActivity {
  - btnPlayWithBot : Button
  - player : Player
  + onPlayWithBotClick(v : View) : void
}

class DifficultyActivity {
  - rgDifficulty : RadioGroup
  - btnStart : Button
  - btnBack : Button
  + onStartClick(v : View) : void
  + onBackClick(v : View) : void
}

class BotGameActivity {
  - boardView : BoardView
  - botBoardView : BoardView
  - tvTimer : TextView
  - tvPlayerRemaining : TextView
  - tvBotRemaining : TextView
  - btnQuit : Button
  - board : Board
  - botBoard : Board
  - bot : Bot
  - firstCell : Cell
  - timer : CountDownTimer
  - handler : Handler
  --
  + onCellClick(cell : Cell) : void
  + onBotTurn() : void
  + onQuitClick(v : View) : void
  - endGame(result : String) : void
}

class BotResultDialog {
  - tvResult : TextView
  - btnOk : Button
  + onOkClick(v : View) : void
}

' ========================================================
' TẦNG 2: LOGIC XỬ LÝ GAME, THUẬT TOÁN, VIEW VÀ SERVER
' ========================================================
class PathFinder {
  + checkPath(board : Board, a : Cell, b : Cell) : ArrayList<Cell>
  + findAvailablePair(board : Board) : Cell[]
}

class Bot {
  - difficulty : Difficulty
  --
  + Bot(difficulty : Difficulty)
  + getDelayMs() : long
  + nextMove(board : Board) : Cell[]
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

class ServerConnection {
  + getInstance() : ServerConnection
  + send(msg : Message) : void
}

class BoardView {
  - board : Board
  - path : ArrayList<Cell>
  --
  + setBoard(board : Board) : void
  + setInteractive(b : boolean) : void
  + showPath(path : ArrayList<Cell>) : void
  # onDraw(canvas : Canvas) : void
  + onTouchEvent(e : MotionEvent) : boolean
}

class BoardGenerator {
  + generateBoard(rows : int, cols : int, iconTypes : int, seed : long) : Board
  + shuffle(board : Board, seed : long) : Board
}

' ========================================================
' TẦNG 3: CÁC LỚP THỰC THỂ (CORE ENTITY)
' ========================================================
class Board {
  - id : int
  - rowCount : int
  - columnCount : int
  - tiles : int[][]
  --
  + removePair(a : Cell, b : Cell) : void
  + isCleared() : boolean
  + countRemaining() : int
  + copy() : Board
}

class Cell {
  - row : int
  - col : int
}

' ========================================================
' ĐỊNH HƯỚNG BỐ CỤC THEO CHIỀU DỌC (3 TẦNG)
' ========================================================
' Hàng ngang Tầng 1
MainActivity -[hidden]right- DifficultyActivity
DifficultyActivity -[hidden]right- BotGameActivity
BotGameActivity -[hidden]right- BotResultDialog

' Từ Tầng 1 xuống Tầng 2
MainActivity -[hidden]down- PathFinder
DifficultyActivity -[hidden]down- Bot
BotGameActivity -[hidden]down- ServerConnection
BotResultDialog -[hidden]down- BoardGenerator

' Hàng ngang Tầng 2
PathFinder -[hidden]right- Bot
Bot -[hidden]right- Difficulty
Difficulty -[hidden]right- ServerConnection
ServerConnection -[hidden]right- BoardView
BoardView -[hidden]right- BoardGenerator

' Từ Tầng 2 xuống Tầng 3
Bot -[hidden]down- Board
Difficulty -[hidden]down- Cell

' Hàng ngang Tầng 3
Board -[hidden]right- Cell

' ========================================================
' CÁC ĐƯỜNG LIÊN KẾT & QUAN HỆ THEO ẢNH
' ========================================================
' Tầng 1 liên kết với nhau
MainActivity -- DifficultyActivity
DifficultyActivity -- BotGameActivity
BotGameActivity -- BotResultDialog
MainActivity -- BotResultDialog

' Tầng 1 nối Tầng 2
BotGameActivity -- ServerConnection
BotGameActivity *-- BoardView
BotGameActivity -- PathFinder
BotGameActivity -- Bot
BotGameActivity -- BoardGenerator

' Quan hệ nội bộ Tầng 2
Bot -- Difficulty

' Tầng 2 nối Tầng 3 & Tầng 1 nối Tầng 3
PathFinder -- Board
BoardGenerator -- Board
BotGameActivity -- Board

' Quan hệ nội bộ Tầng 3
Board -- Cell

@enduml