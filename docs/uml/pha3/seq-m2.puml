@startuml seq-m2
title Biểu đồ tuần tự - Modul View Ranking

skinparam shadowing false
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ArrowColor #4A4A4A
skinparam sequence {
  LifeLineBorderColor #4A4A4A
  ParticipantBorderColor #4A4A4A
  ParticipantBackgroundColor #F7F7F7
  ActorBorderColor #4A4A4A
  ActorBackgroundColor #F7F7F7
}
autonumber "<b>0:"

actor "Quản trị server" as Admin
actor "Người chơi" as Player
boundary MainActivity
boundary RankingActivity
control ServerConnection
control GameServer
control ClientHandler
control RankingController
control PlayerRankingDAO
entity "Player\nRanking" as PlayerRanking

Admin -> GameServer : chạy server
GameServer -> GameServer : main()
activate GameServer
GameServer -> Admin : hiển thị
Player -> MainActivity : mở ứng dụng
MainActivity -> ServerConnection : gọi
ServerConnection -> ServerConnection : connect()
activate ServerConnection
ServerConnection -> GameServer : kết nối (TCP)
GameServer -> ClientHandler : gọi
ClientHandler -> ClientHandler : ClientHandler()
activate ClientHandler
ClientHandler --> GameServer : trả về
deactivate ClientHandler
GameServer -> ClientHandler : run() (luồng mới)
GameServer --> ServerConnection : chấp nhận (TCP)
deactivate GameServer
ServerConnection --> MainActivity : trả về
deactivate ServerConnection
MainActivity -> Player : hiển thị
Player -> MainActivity : click xem bảng xếp hạng
MainActivity -> RankingActivity : gọi
RankingActivity -> ServerConnection : send(GET_RANKING)
ServerConnection -> ClientHandler : GET_RANKING (TCP)
ClientHandler -> RankingController : handleGetRanking()
RankingController -> PlayerRankingDAO : gọi
PlayerRankingDAO -> PlayerRankingDAO : getRanking()
activate PlayerRankingDAO
PlayerRankingDAO -> PlayerRanking : gọi
PlayerRanking -> PlayerRanking : PlayerRanking()
activate PlayerRanking
PlayerRanking --> PlayerRankingDAO : trả về
deactivate PlayerRanking
PlayerRankingDAO --> RankingController : trả về
deactivate PlayerRankingDAO
RankingController -> ClientHandler : send(RANKING)
ClientHandler -> ServerConnection : RANKING (TCP)
ServerConnection -> RankingActivity : onMessage()
RankingActivity -> Player : hiển thị
Player -> RankingActivity : click vị trí của tôi
RankingActivity -> ServerConnection : send(GET_RANKING)
ServerConnection -> ClientHandler : GET_RANKING (TCP)
ClientHandler -> RankingController : handleGetRanking()
RankingController -> PlayerRankingDAO : gọi
PlayerRankingDAO -> PlayerRankingDAO : getRanking()
activate PlayerRankingDAO
PlayerRankingDAO -> PlayerRanking : gọi
PlayerRanking -> PlayerRanking : PlayerRanking()
activate PlayerRanking
PlayerRanking --> PlayerRankingDAO : trả về
deactivate PlayerRanking
PlayerRankingDAO --> RankingController : trả về
deactivate PlayerRankingDAO
RankingController -> ClientHandler : send(RANKING)
ClientHandler -> ServerConnection : RANKING (TCP)
ServerConnection -> RankingActivity : onMessage()
RankingActivity -> Player : hiển thị
Player -> RankingActivity : click quay lại
RankingActivity -> MainActivity : gọi
MainActivity -> Player : hiển thị
@enduml
