@startuml seq-m4-2
title Biểu đồ tuần tự - Modul Play Online Match (phần 2: chơi ván)

skinparam shadowing false
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ArrowColor #4A4A4A
skinparam sequence {
  LifeLineBorderColor #4A4A4A
  ParticipantBorderColor #4A4A4A
  ParticipantBackgroundColor #F7F7F7
  ActorBorderColor #4A4A4A
  ActorBackgroundColor #F7F7F7
}
autonumber "<b>0:"
autonumber 60 "<b>0:"

actor "Người chơi A" as A
boundary MatchActivity
control "Server\nConnection" as ServerConnection
control "Client\nHandler" as ClientHandler
control "Match\nController" as MatchController
control "Match\nManager" as MatchManager
control PathFinder
entity Board

loop lặp đến khi một người xóa hết ô
A -> MatchActivity : click hai ô
MatchActivity -> ServerConnection : send(MOVE)
ServerConnection -> ClientHandler : MOVE (TCP)
ClientHandler -> MatchController : handleMove()
MatchController -> MatchManager : gọi
MatchManager -> MatchManager : getRoom()
activate MatchManager
MatchManager --> MatchController : trả về
deactivate MatchManager
MatchController -> PathFinder : gọi
PathFinder -> PathFinder : checkPath()
activate PathFinder
PathFinder --> MatchController : trả về
deactivate PathFinder
MatchController -> Board : gọi
Board -> Board : removePair()
activate Board
Board --> MatchController : trả về
deactivate Board
MatchController -> Board : gọi
Board -> Board : isCleared()
activate Board
Board --> MatchController : trả về
deactivate Board
MatchController -> PathFinder : gọi
PathFinder -> PathFinder : findAvailablePair()
activate PathFinder
PathFinder --> MatchController : trả về
deactivate PathFinder
MatchController -> ClientHandler : send(MOVE_RESULT)
ClientHandler -> ServerConnection : MOVE_RESULT,\nOPPONENT_PROGRESS (TCP)
ServerConnection -> MatchActivity : onMessage()
MatchActivity -> A : hiển thị
end
@enduml
