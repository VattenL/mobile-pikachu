@startuml ui-m4-confirm
skinparam shadowing false
skinparam defaultFontSize 12
skinparam defaultFontColor #333333
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #BDBDBD
  RoundCorner 8
}

rectangle Confirm [
{{salt
{
  <b>Xác nhận thách đấu
  .
  Bạn muốn thách đấu B?
  .
  [ Hủy ] | [ Xác nhận ]
}
}}
]

rectangle Waiting [
{{salt
{
  <b>Đang chờ trả lời
  .
  Đang chờ B trả lời... (còn 25 giây)
  .
  [ Hủy lời mời ]
}
}}
]

Confirm -right-> Waiting : Xác nhận
@enduml
