@startuml ui-m2
title Thiết kế giao diện - Modul Play With Bot (màn hình ngang)

skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowColor #4A4A4A
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #9E9E9E
}

rectangle Main [
{{salt
{+
  { {+
      <b>Hoàng Nam
      11 điểm
      .
      .
      [ Xem bảng xếp hạng ]
      [   Chơi với máy    ]
      [     Đăng xuất     ]
    } | {+
      <b>Người chơi online
      {#
        <b>Tên | <b>Tổng điểm | <b>Trạng thái
        Minh Anh | 12.5 | Rỗi
        Quốc Bảo | 10.5 | Bận
        Thu Hà | 7.5 | Rỗi
      }
    } }
}
}}
]

rectangle Difficulty [
{{salt
{+
  <b>Chọn độ khó
  .
  { {+ (Togepi)
       <b>Dễ } | {+ (Pikachu)
       <b>Trung bình } | {+ (Charizard)
       <b>Khó } }
  .
  [ Quay lại ] | [ Bắt đầu ]
}
}}
]

rectangle Game [
{{salt
{+
  { {+
      <b>Đấu máy · Trung bình
      09:12
      .
      <b>Bạn
      98 ô
      .
      [ Thoát ]
    } | {#
      A | B | C | D | E | F
      G | A | . | H | B | C
      D | . | E | F | G | H
      B | C | A | . | D | E
      F | G | H | A | . | B
      C | D | E | F | G | A
    } | {+
      <b>Máy · 96 ô
      {#
        A | B | . | D | E | F
        G | A | . | H | B | C
        D | . | E | F | . | H
        B | C | A | . | D | E
        . | G | H | A | . | B
        C | D | E | F | G | A
      }
      <i>(bàn của máy, chỉ xem)
    } }
}
}}
]

rectangle Result [
{{salt
{+
  <b>Chiến thắng!
  .
  Bạn thắng. Thời gian hoàn thành 07:15.
  Máy còn 12 ô.
  .
  [ OK ]
}
}}
]

Main -right-> Difficulty : chơi với máy
Difficulty -left-> Main : quay lại
Difficulty -down-> Game : bắt đầu
Game -right-> Result : kết thúc ván
Game -up-> Main : thoát
Result -up-> Main : OK
@enduml
