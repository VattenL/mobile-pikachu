@startuml ui-m2
title Thiết kế giao diện - Modul View Ranking

skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowColor #4A4A4A
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #9E9E9E
}

rectangle Login [
{{salt
{+
  <b>Đăng nhập
  .
  Tên đăng nhập
  "nguoichoia      "
  Mật khẩu
  "********        "
  <color:red>Sai tên đăng nhập hoặc mật khẩu
  .
  [   Đăng nhập   ]
  [    Đăng ký    ]
}
}}
]

rectangle Main [
{{salt
{+
  { {+
      <b>Người chơi A
      11 điểm
      .
      .
      [ Xem bảng xếp hạng ]
      [   Chơi với máy    ]
      [     Đăng xuất     ]
    } | {+
      <b>Người chơi online
      {#
        <b>Tên | <b>Tổng điểm | <b>Trạng thái
        Người chơi B | 12.5 | Rỗi
        Người chơi C | 10.5 | Bận
        Người chơi D | 7.5 | Luyện tập
      }
    } }
}
}}
]

rectangle Ranking [
{{salt
{+
  <b>Bảng xếp hạng
  .
  {#
    <b>Hạng | <b>Tên | <b>Tổng điểm | <b>TB điểm đối thủ | <b>TB thời gian thắng
    1 | Người chơi B | 12.5 | 9.2 | 05:48
    2 | Người chơi A | 11 | 10.1 | 06:10
    3 | Người chơi C | 10.5 | 9.5 | 06:31
    4 | Người chơi D | 7.5 | 11.0 | 07:02
    5 | Người chơi E | 7.5 | 8.4 | 06:55
  }
  .
  [ Quay lại ]
}
}}
]

Login -right-> Main : đăng nhập\nthành công
Main -right-> Ranking : xem bảng\nxếp hạng
Ranking -left-> Main : quay lại
@enduml
