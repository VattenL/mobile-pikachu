@startuml seq-m4
title Biểu đồ tuần tự - Modul Manage Account

skinparam shadowing false
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ArrowColor #4A4A4A
skinparam sequence {
  LifeLineBorderColor #4A4A4A
  ParticipantBorderColor #4A4A4A
  ParticipantBackgroundColor #F7F7F7
  ActorBorderColor #4A4A4A
  ActorBackgroundColor #F7F7F7
}
autonumber "<b>0:"

actor "Người chơi" as Player
boundary "Register\nActivity" as RegisterActivity
boundary LoginActivity
boundary MainActivity
control "Server\nConnection" as ServerConnection
control "Client\nHandler" as ClientHandler
control "Login\nController" as LoginController
control "OnlinePlayer\nManager" as OnlinePlayerManager
control "Challenge\nController" as ChallengeController
control PlayerDAO
entity "Player" as PlayerE

Player -> LoginActivity : click đăng ký
LoginActivity -> RegisterActivity : gọi
RegisterActivity -> Player : hiển thị
Player -> RegisterActivity : nhập, click đăng ký
RegisterActivity -> ServerConnection : send(REGISTER)
ServerConnection -> ClientHandler : REGISTER (TCP)
ClientHandler -> LoginController : handleRegister()
LoginController -> PlayerDAO : gọi
PlayerDAO -> PlayerDAO : addPlayer()
activate PlayerDAO
PlayerDAO --> LoginController : trả về
deactivate PlayerDAO
LoginController -> ClientHandler : send(REGISTER_RESULT)
ClientHandler -> ServerConnection : REGISTER_RESULT (TCP)
ServerConnection -> RegisterActivity : onMessage()
RegisterActivity -> LoginActivity : gọi
LoginActivity -> Player : hiển thị
Player -> LoginActivity : nhập mật khẩu, click đăng nhập
LoginActivity -> ServerConnection : send(LOGIN)
ServerConnection -> ClientHandler : LOGIN (TCP)
ClientHandler -> LoginController : handleLogin()
LoginController -> PlayerDAO : gọi
PlayerDAO -> PlayerDAO : checkLogin()
activate PlayerDAO
PlayerDAO -> PlayerE : gọi
PlayerE -> PlayerE : Player()
activate PlayerE
PlayerE --> PlayerDAO : trả về
deactivate PlayerE
PlayerDAO --> LoginController : trả về
deactivate PlayerDAO
LoginController -> OnlinePlayerManager : gọi
OnlinePlayerManager -> OnlinePlayerManager : addOnlinePlayer()
activate OnlinePlayerManager
OnlinePlayerManager --> LoginController : trả về
deactivate OnlinePlayerManager
LoginController -> ClientHandler : send(LOGIN_RESULT)
ClientHandler -> ServerConnection : LOGIN_RESULT (TCP)
ServerConnection -> LoginActivity : onMessage()
LoginActivity -> MainActivity : gọi
MainActivity -> Player : hiển thị
Player -> MainActivity : click đăng xuất
MainActivity -> ServerConnection : send(LOGOUT)
MainActivity -> LoginActivity : gọi
LoginActivity -> Player : hiển thị
ServerConnection -> ClientHandler : LOGOUT (TCP)
ClientHandler -> LoginController : handleLogout()
LoginController -> OnlinePlayerManager : gọi
OnlinePlayerManager -> OnlinePlayerManager : removeOnlinePlayer()
activate OnlinePlayerManager
OnlinePlayerManager --> LoginController : trả về
deactivate OnlinePlayerManager
LoginController -> ChallengeController : broadcastOnlineList()
@enduml
