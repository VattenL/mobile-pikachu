@startuml class-design-m2
title Biểu đồ lớp thiết kế - Modul Play With Bot

hide circle
hide empty members
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam class {
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
  FontColor #1A1A1A
}

' ===== Client Android: tang giao dien =====
class MainActivity #E3F2FD {
  - btnPlayWithBot : Button
  - player : Player
  + onPlayWithBotClick(v : View) : void
}

class DifficultyActivity #E3F2FD {
  - rgDifficulty : RadioGroup
  - btnStart : Button
  - btnBack : Button
  + onStartClick(v : View) : void
  + onBackClick(v : View) : void
}

class BotGameActivity #E3F2FD {
  - boardView : BoardView
  - botBoardView : BoardView
  - tvTimer : TextView
  - tvPlayerRemaining : TextView
  - tvBotRemaining : TextView
  - btnQuit : Button
  - board : Board
  - botBoard : Board
  - bot : Bot
  - firstCell : Cell
  - timer : CountDownTimer
  - handler : Handler
  + onCellClick(cell : Cell) : void
  + onBotTurn() : void
  + onQuitClick(v : View) : void
  - endGame(result : String) : void
}

class BotResultDialog #E3F2FD {
  - tvResult : TextView
  - btnOk : Button
  + onOkClick(v : View) : void
}

class ServerConnection #EDE7F6 {
  + getInstance() : ServerConnection
  + send(msg : Message) : void
}

class BoardView #E3F2FD {
  - board : Board
  - path : ArrayList<Cell>
  + setBoard(board : Board) : void
  + setInteractive(b : boolean) : void
  + showPath(path : ArrayList<Cell>) : void
  # onDraw(canvas : Canvas) : void
  + onTouchEvent(e : MotionEvent) : boolean
}

' ===== core: xu ly ban choi =====
class BoardGenerator #E8F5E9 {
  + generateBoard(rows : int, cols : int, iconTypes : int, seed : long) : Board
  + shuffle(board : Board, seed : long) : Board
}

class PathFinder #E8F5E9 {
  + checkPath(board : Board, a : Cell, b : Cell) : ArrayList<Cell>
  + findAvailablePair(board : Board) : Cell[]
}

class Bot #E8F5E9 {
  - difficulty : Difficulty
  + Bot(difficulty : Difficulty)
  + getDelayMs() : long
  + nextMove(board : Board) : Cell[]
}

enum Difficulty #E8F5E9 {
  EASY
  MEDIUM
  HARD
}

' ===== core: lop thuc the =====
class Board #FFF3E0 {
  - id : int
  - rowCount : int
  - columnCount : int
  - tiles : int[][]
  + removePair(a : Cell, b : Cell) : void
  + isCleared() : boolean
  + countRemaining() : int
  + copy() : Board
}

class Cell #FFF3E0 {
  - row : int
  - col : int
}

MainActivity -right- DifficultyActivity
DifficultyActivity -right- BotGameActivity
BotGameActivity -right- BotResultDialog
BotResultDialog -[norank]- MainActivity
BotGameActivity *-down- BoardView
BotGameActivity -down- ServerConnection

BotGameActivity -down- BoardGenerator
BotGameActivity -down- PathFinder
BotGameActivity -down- Bot
Bot -right- Difficulty
Bot -left- PathFinder

BoardGenerator -down- Board
PathFinder -down- Board
BotGameActivity -[norank]- Board
Board -right- Cell
@enduml
