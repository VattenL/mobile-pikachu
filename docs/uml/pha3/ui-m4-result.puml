  BorderColor #BDBDBD
  RoundCorner 8
}

rectangle Result [
{{salt
{
  <b>Chiến thắng!
  .
  Bạn thắng (+1 điểm). Thời gian hoàn thành 06:42.
  Bạn có muốn tái đấu không? (còn 25 giây)
  .
  [ Dừng ] | [ Tái đấu ]
}
}}
]

rectangle Left [
