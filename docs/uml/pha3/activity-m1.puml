@startuml activity-m1
title Biểu đồ hoạt động - Modul View Ranking

skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowColor #4A4A4A
skinparam activity {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}
skinparam partition {
  BorderColor #9E9E9E
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #9E9E9E
}

start
repeat
  partition "Xử lí tại LoginActivity" {
    :Nhận tên đăng nhập, mật khẩu;
    :Gửi message LOGIN;
  }
  partition "Xử lí tại server: LoginController.handleLogin()" {
    :Kiểm tra tài khoản;
    note right: PlayerDAO:\ncheckLogin()
    if (Đúng tài khoản?) then ([đúng])
      :Thêm vào danh sách online;
      note right: OnlinePlayerManager:\naddOnlinePlayer()
    else ([sai])
    endif
    :Gửi LOGIN_RESULT;
  }
repeat while () is ([sai tài khoản hoặc\nđang đăng nhập nơi khác])
->[đăng nhập thành công];
partition "Xử lí tại LoginActivity " {
  :Lưu người chơi vào ClientSession;
}
partition "Xử lí tại MainActivity" {
  :Hiển thị giao diện chính;
}
->[click xem bảng xếp hạng];
partition "Xử lí tại RankingActivity" {
  :Gửi message GET_RANKING;
}
partition "Xử lí tại server: RankingController.handleGetRanking()" {
  :Lấy bảng xếp hạng;
  note right: PlayerRankingDAO:\ngetRanking()
  :Gửi message RANKING;
}
partition "Xử lí tại RankingActivity " {
  :Hiển thị bảng xếp hạng;
}
->[click quay lại];
partition "Xử lí tại MainActivity " {
  :Hiển thị giao diện chính;
}
stop
@enduml
