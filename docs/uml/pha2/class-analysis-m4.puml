@startuml class-analysis-m4
title Biểu đồ lớp pha phân tích - Modul Play Online Match

hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam class {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
  FontColor #1A1A1A
}

' ===== Tang 1: lop bien =====
class MainScreen {
  - outOnlinePlayerList
  - outMessage
  - subSelectOpponent
}

class ChallengeConfirmDialog {
  - outOpponent
  - subConfirm
  - subCancel
}

class InvitationDialog {
  - outChallenger
  - subAccept
  - subReject
}

class MatchScreen {
  - outBoard
  - outRemainingTime
  - outOpponentTileCount
  - inTile
  - subQuit
}

class ResultDialog {
  - outResult
  - subContinue
  - subStop
}

' ===== Tang 2: lop thuc the =====
class Player {
  - username
  - password
  - name
  - status
  + getOnlinePlayers()
  + sendInvitation()
  + updateStatus()
}

class PlayerRanking {
  - totalPoint
  - avgOpponentPoint
  - avgWinTime
  + getTotalPoints()
}

class Board {
  - rowCount
  - columnCount
  - tiles
  + generateBoard()
  + checkPath()
  + removePair()
  + isCleared()
  + findAvailablePair()
  + shuffle()
}

class Match {
  - startTime
  - endTime
  - timeLimit
  + createMatch()
  + saveMatch()
}

class MatchResult {
  - result
  - point
  - finishTime
}

MainScreen -left- ChallengeConfirmDialog
MainScreen -right- InvitationDialog
InvitationDialog -right- MatchScreen
MatchScreen -right- ResultDialog
ResultDialog -[norank]- MainScreen

MainScreen -down- Player
MainScreen -down- PlayerRanking
InvitationDialog -down- Board
InvitationDialog -down- Match
InvitationDialog -down- Player
MatchScreen -down- Board
MatchScreen -down- Match
ResultDialog -down- Player
ResultDialog -down- Board
ResultDialog -down- Match

Player "1" -[norank]-o "0..*" MatchResult
Match "1" *-down- "2" MatchResult
Match "0..1" o-right- "1" Board
MatchResult "0..1" o-[norank]- "1" Board
PlayerRanking -[norank]-|> Player
@enduml
