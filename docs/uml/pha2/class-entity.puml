@startuml class-entity
title Biểu đồ lớp thực thể pha phân tích - Game Pikachu

hide circle
hide methods
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam class {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
  FontColor #1A1A1A
}

class Player {
  username
  password
  name
  status
}

class PlayerRanking {
  totalPoint
  avgOpponentPoint
  avgWinTime
}

class Match {
  startTime
  endTime
  timeLimit
}

class MatchResult {
  result
  point
  finishTime
}

class Board {
  rowCount
  columnCount
  tiles
}

Player -[hidden]right- PlayerRanking
Player "1" -down-o "0..*" MatchResult
Match "1" *-right- "2" MatchResult
Board "1" -down-o "0..1" Match
PlayerRanking .down.> MatchResult : <<derive>>
@enduml
