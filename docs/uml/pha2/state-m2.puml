@startuml state-m2
title Biểu đồ trạng thái - Modul View Ranking

skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontSize 13
skinparam nodesep 120
skinparam ranksep 90
skinparam state {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
  FontColor #1A1A1A
}

state "Hiển thị LoginScreen" as Login
state "Hiển thị MainScreen" as Main
state "Hiển thị RankingScreen" as Ranking

[*] --> Login
Login --> Login : [click đăng nhập, sai tài khoản]
Login --> Main : [click đăng nhập, đúng tài khoản]
Main --> Ranking : [click xem bảng xếp hạng]
Ranking --> Main : [click quay lại]
@enduml
