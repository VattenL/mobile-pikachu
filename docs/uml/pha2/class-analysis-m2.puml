@startuml class-analysis-m2
title Biểu đồ lớp pha phân tích - Modul View Ranking

hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam classFontSize 14
skinparam classAttributeFontSize 12
skinparam class {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
  FontColor #1A1A1A
}

' ===== Tang 1: lop bien =====
class MainScreen {
  - subViewRanking
}

class RankingScreen {
  - outRanking
  - outPage
  - subPrevPage
  - subNextPage
  - subMyRank
  - subBack
}

' ===== Tang 2: lop thuc the =====
class Player {
  - username
  - password
  - status
}

class PlayerRanking {
  - totalPoint
  - avgOpponentPoint
  - avgWinTime
  + getRanking()
  + getPlayerPage()
}

MainScreen -right- RankingScreen
RankingScreen -down- PlayerRanking
PlayerRanking -left-|> Player
@enduml
