@startuml comm-m4
title Biểu đồ giao tiếp - Modul Manage Account

skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 70
skinparam ranksep 90
skinparam defaultFontSize 12
skinparam ArrowColor #4A4A4A
skinparam actor {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}
skinparam boundary {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}
skinparam entity {
  BackgroundColor #F7F7F7
  BorderColor #4A4A4A
}

actor "Người chơi" as Actor

boundary RegisterScreen
boundary LoginScreen
boundary MainScreen

entity Player

Actor -down- LoginScreen : "1: click đăng ký ↓\n9: hiển thị ↑\n10: nhập mật khẩu, click đăng nhập ↓\n24: hiển thị ↑"
Actor -down- RegisterScreen : "3: hiển thị ↑\n4: nhập thông tin, click đăng ký ↓"
Actor -down- MainScreen : "18: hiển thị ↑\n19: click đăng xuất ↓"
RegisterScreen -right- LoginScreen : "2: gọi ←\n8: gọi →"
LoginScreen -right- MainScreen : "17: gọi →\n23: gọi ←"
RegisterScreen -down- Player : "5: gọi ↓\n7: trả về ↑"
LoginScreen -down- Player : "11: gọi ↓\n13: trả về ↑\n14: gọi ↓\n16: trả về ↑"
MainScreen -down- Player : "20: gọi ↓\n22: trả về ↑"
Player -right- Player : "6: addPlayer()\n12: checkLogin()\n15: addOnlinePlayer()\n21: removeOnlinePlayer()"
@enduml
