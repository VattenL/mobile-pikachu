<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng của bảng xếp hạng; cũng dùng làm dòng tiêu đề cột. Tỉ lệ cột theo Hình 3.6. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingHorizontal="4dp"
        android:text="@string/col_rank" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3.3"
        android:paddingHorizontal="4dp"
        android:text="@string/col_name" />

    <TextView
        android:id="@+id/tvTotalPoint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:paddingHorizontal="4dp"
        android:text="@string/col_total_point" />

    <TextView
        android:id="@+id/tvAvgOpponentPoint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.7"
        android:paddingHorizontal="4dp"
        android:text="@string/col_avg_opponent_point" />

    <TextView
        android:id="@+id/tvAvgWinTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:paddingHorizontal="4dp"
        android:text="@string/col_avg_win_time" />
</LinearLayout>
