<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng của danh sách người chơi online; cũng dùng làm dòng tiêu đề cột. Tỉ lệ cột theo Hình 3.10. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingHorizontal="4dp"
        android:text="@string/col_index" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4.7"
        android:paddingHorizontal="4dp"
        android:text="@string/col_name" />

    <TextView
        android:id="@+id/tvTotalPoint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.7"
        android:paddingHorizontal="4dp"
        android:text="@string/col_total_point" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3.3"
        android:paddingHorizontal="4dp"
        android:text="@string/col_status" />
</LinearLayout>
